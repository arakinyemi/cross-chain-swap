# Environment
.env
.env.*
!.env.example

# Go build artifacts
bin/
dist/
build/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Coverage and profiling
coverage.out
coverage.html
*.coverprofile
*.prof

# Logs
*.log
logs/

# Local database/files
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Codex/agent local state
.agents/
.codex/
.gstack/

# Frontend
web/node_modules/
web/dist/
.vite/

# Built interface bundle, embedded by internal/ui at go build time.
# The directory itself is tracked (via .gitkeep) so `go build` works on a fresh
# clone; the generic dist/ rule above would otherwise swallow it, and git cannot
# re-include a file whose parent directory is excluded.
!internal/ui/dist/
internal/ui/dist/*
!internal/ui/dist/.gitkeep
